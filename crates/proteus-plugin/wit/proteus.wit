/// The Proteus plugin API, version 1 (docs/design/05-scripting.md).
///
/// A plugin is a component (`wasm32-wasip2`) exporting `init`, `on-event`
/// and `on-ui`. Calls into the host that need a permission the user did
/// not grant return `err("permission denied: NAME")`.
package proteus:plugin@1.0.0;

interface types {
    type pane-id = u64;
    type surface-id = u32;
    type timer-id = u32;
    /// A process started with `spawn-process`.
    type process-id = u32;
    /// A streaming HTTP request, or a question (`prompt`, `confirm`).
    type request-id = u32;
    type watch-id = u32;
    type task-id = u32;
    type image-id = u32;

    /// What a pane is (permission `read-panes`).
    record pane-info {
        id: pane-id,
        /// What the tab bar shows.
        title: string,
        /// Set by the user.
        name: option<string>,
        cwd: option<string>,
        /// Foreground program (the shell when idle).
        process: option<string>,
        /// Command line of the running command (shell integration).
        command: option<string>,
        window: u32,
        /// 1-based tab index in its window.
        tab: u32,
        /// The focused pane of the active tab of its window.
        focused: bool,
        floating: bool,
        cols: u32,
        rows: u32,
    }

    enum block-state { prompt, input, running, finished }

    /// A command block (shell integration).
    record block-info {
        id: u64,
        command: option<string>,
        cwd: option<string>,
        exit-code: option<s32>,
        /// Milliseconds (so far, while running).
        duration-ms: option<u64>,
        state: block-state,
    }

    record command-finished {
        pane: pane-id,
        command: option<string>,
        exit-code: option<s32>,
        duration-ms: option<u64>,
    }

    /// 0xRRGGBB.
    type rgb = u32;

    record theme {
        fg: rgb,
        bg: rgb,
        accent: rgb,
        /// Bars and inactive chrome.
        bar: rgb,
        dim: rgb,
        dark: bool,
    }

    /// Terminal events. Pane events need `read-panes`.
    variant event {
        pane-opened(pane-id),
        pane-closed(pane-id),
        focus-changed(pane-id),
        cwd-changed(tuple<pane-id, string>),
        title-changed(tuple<pane-id, string>),
        command-started(tuple<pane-id, option<string>>),
        command-finished(command-finished),
        bell(pane-id),
        /// A palette entry of this plugin (`register-action`) was chosen.
        action(string),
        timer(timer-id),
        /// The terminal's colors changed (also sent once after `init`).
        theme-changed(theme),
        /// A command block changed state (`read-panes`).
        block-state-changed(tuple<pane-id, block-info>),
        /// The user's configuration was reloaded.
        config-changed,
        /// Output of a process from `spawn-process`.
        process-output(process-output),
        /// A process from `spawn-process` ended: its exit code (none: killed by a signal).
        process-exited(tuple<process-id, option<s32>>),
        /// Status and headers of an `http-stream` request.
        http-response(http-head),
        /// The next part of its body.
        http-body(tuple<request-id, list<u8>>),
        /// The request is over: none, or what went wrong.
        http-done(tuple<request-id, option<string>>),
        /// Something changed in a watched directory.
        fs-changed(fs-change),
        /// The answer to `prompt` (none: cancelled) or `confirm` (some("") is yes).
        answered(tuple<request-id, option<string>>),
        /// The user cancelled a task.
        task-cancelled(task-id),
        /// The host made a pane surface for this plugin: from a layout
        /// (`plugin = "ID"`, with its `args`) or again after a restart.
        surface-opened(tuple<surface-id, string>),
    }

    record process-output {
        id: process-id,
        /// From stderr instead of stdout.
        stderr: bool,
        data: list<u8>,
    }

    /// A program to run (permission `run-command`). The program is looked
    /// up in `PATH` and must be one the manifest lists; no shell is used.
    record command {
        argv: list<string>,
        /// Default: the plugin's data directory.
        cwd: option<string>,
        /// Added to the environment (which is the terminal's otherwise).
        env: list<tuple<string, string>>,
    }

    record output {
        /// None: killed by a signal (or the timeout).
        exit-code: option<s32>,
        stdout: list<u8>,
        stderr: list<u8>,
    }

    /// An HTTP(S) request (permission `network`: the host must be listed).
    /// Redirects are not followed.
    record http-request {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
        /// 0: 30 seconds (whole request); for streams, the wait for headers.
        timeout-ms: u32,
    }

    record http-response {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record http-head {
        id: request-id,
        status: u16,
        headers: list<tuple<string, string>>,
    }

    enum fs-change-kind { created, removed, modified, moved }

    /// An entry of `list-dir`.
    record dir-entry {
        name: string,
        /// A directory, or a symlink to one.
        dir: bool,
        link: bool,
        /// Of what a link points at (when it is inside the plugin's
        /// directories; else of the link).
        size: u64,
        /// Seconds since the epoch.
        mtime: s64,
    }

    record fs-change {
        watch: watch-id,
        /// Absolute path of what changed.
        path: string,
        kind: fs-change-kind,
    }

    flags attrs { bold, dim, italic, underline, reverse, strike }

    /// A color: a palette index (0-255) or a direct color.
    variant color {
        indexed(u8),
        rgb(rgb),
    }

    record style {
        fg: option<color>,
        bg: option<color>,
        attrs: attrs,
    }

    record span {
        text: string,
        style: style,
        /// Clickable link (opened like OSC 8 hyperlinks).
        link: option<string>,
    }

    /// One row of a surface. Rows wider than the surface are cut off.
    type line = list<span>;

    /// A whole surface: rows from the top; missing rows are blank.
    record frame {
        lines: list<line>,
        /// Text cursor (column, row) for a text input; none hides it.
        cursor: option<tuple<u32, u32>>,
        /// Fill color of the surface (default: the terminal background).
        background: option<color>,
        /// Images over the text (from `load-image`).
        images: list<image-place>,
    }

    /// An image scaled into `cols` × `rows` cells at (`col`, `row`).
    record image-place {
        image: image-id,
        col: u32,
        row: u32,
        cols: u32,
        rows: u32,
    }

    enum surface-kind {
        /// Docked at the left of the window, full height.
        sidebar-left,
        sidebar-right,
        /// A popup in the middle of the window.
        float,
        /// A pane in the layout: split right of / below the pane, or a new tab.
        pane-right,
        pane-down,
        tab,
        /// A popup at the text cursor of a pane (below the cursor line, or
        /// above it when there is no room), e.g. a completion menu. It has
        /// no title row and does not take the keyboard unless asked.
        overlay,
    }

    record surface-options {
        kind: surface-kind,
        /// Shown in the surface's title row (panes: the tab and pane title).
        title: string,
        /// Sidebars: width in columns. Floats and overlays: width and height.
        cols: u32,
        rows: u32,
        /// Take the keyboard when it opens.
        focus: bool,
        /// Panes and overlays: the pane they are placed at (default: the
        /// focused one).
        pane: option<pane-id>,
    }

    flags modifiers { shift, ctrl, alt, logo }

    record key-event {
        /// `a`, `enter`, `escape`, `tab`, `backspace`, `up`, `down`, `left`,
        /// `right`, `home`, `end`, `page-up`, `page-down`, `insert`,
        /// `delete`, `f1`..`f35`. Letters are lowercase; see `text`.
        key: string,
        /// What the key types (with Shift applied), if anything.
        text: string,
        mods: modifiers,
        repeat: bool,
    }

    enum mouse-button { left, middle, right, wheel-up, wheel-down }

    enum mouse-action {
        press,
        release,
        /// Moved with a button held (`button`), from a press on the surface.
        drag,
    }

    record mouse-event {
        button: mouse-button,
        col: u32,
        row: u32,
        mods: modifiers,
        action: mouse-action,
    }

    /// Events of one surface.
    variant ui-event {
        key(key-event),
        /// Text from the input method, or pasted.
        text(string),
        /// The input method's composition (shown by the host at the frame's
        /// cursor) and the byte offset of its cursor; none: it ended.
        preedit(option<tuple<string, u32>>),
        mouse(mouse-event),
        /// The surface's size in cells; it should be drawn again.
        resize(tuple<u32, u32>),
        /// Got (true) or lost the keyboard.
        focus(bool),
        /// Closed by the user; the id is no longer valid.
        closed,
        /// Files dropped onto the surface (absolute paths).
        drop(list<string>),
    }

    enum status-side { left, right }

    /// How to start a new pane (permission `open-pane`).
    record spawn {
        /// Program and arguments; empty: the shell.
        argv: list<string>,
        /// Default: the directory of the focused pane.
        cwd: option<string>,
    }

    enum placement { split-right, split-down, new-tab, float }
}

interface host {
    use types.{pane-id, pane-info, block-info, surface-id, surface-options, frame, status-side, timer-id, spawn, placement,
        process-id, request-id, watch-id, task-id, image-id, command, output, http-request, http-response, dir-entry};

    /// A line in the plugin log (stderr of the terminal, with `PROTEUS_DEBUG`).
    log: func(message: string);
    /// A message in the window.
    notify: func(text: string, error: bool);

    // --- panes ---------------------------------------------------------------
    list-panes: func() -> result<list<pane-info>, string>;
    get-pane: func(id: pane-id) -> result<option<pane-info>, string>;
    /// The host of the pane's cwd (OSC 7) when it is not this machine,
    /// e.g. over ssh (its `cwd` is then none); none: local.
    pane-remote: func(id: pane-id) -> result<option<string>, string>;
    focused-pane: func() -> result<option<pane-id>, string>;
    /// Show a pane: its window, tab, and focus (`read-panes`).
    focus-pane: func(id: pane-id) -> result<_, string>;
    /// Type text into a pane (`write-pty`); `paste`: as a paste.
    send-text: func(id: pane-id, text: string, paste: bool) -> result<_, string>;
    /// Screen text with up to `scrollback` lines above it (`read-screen`).
    read-screen: func(id: pane-id, scrollback: u32) -> result<string, string>;
    /// Command blocks, oldest first (`read-screen`).
    read-blocks: func(id: pane-id) -> result<list<block-info>, string>;
    /// Start a pane next to the focused one (`open-pane`).
    open-pane: func(at: placement, what: spawn) -> result<pane-id, string>;

    // --- ui (permission `ui`) -----------------------------------------------
    open-surface: func(options: surface-options) -> result<surface-id, string>;
    /// Replace what a surface shows.
    draw: func(surface: surface-id, frame: frame) -> result<_, string>;
    close-surface: func(surface: surface-id);
    /// Give a surface the keyboard.
    focus-surface: func(surface: surface-id) -> result<_, string>;
    /// Size of a surface in cells (columns, rows).
    /// During a mouse drag that started on `surface`: carry `paths`. If the
    /// button is released over a terminal pane, the host pastes them there,
    /// shell-quoted and separated by spaces.
    start-drag: func(surface: surface-id, paths: list<string>) -> result<_, string>;
    surface-size: func(surface: surface-id) -> result<tuple<u32, u32>, string>;
    /// A tab-bar segment; empty text removes it.
    set-status: func(side: status-side, text: string) -> result<_, string>;
    /// A command palette entry; choosing it sends `event::action(name)`.
    /// `key` suggests a key for it in Normal mode (`alt+g`), or in another
    /// mode as `MODE:KEY` (`pane:e`); it is bound
    /// only if the user has not bound that key. The user can bind the
    /// action to any key as `plugin:ID:NAME`.
    register-action: func(name: string, key: option<string>) -> result<_, string>;
    /// Decode a PNG, JPEG, GIF or WebP image for frames (at most 64 MiB of
    /// pixels per plugin).
    load-image: func(data: list<u8>) -> result<image-id, string>;
    drop-image: func(id: image-id);
    /// Ask the user for a line of text; the answer comes as `event::answered`.
    prompt: func(question: string, initial: string) -> result<request-id, string>;
    /// Ask a yes/no question; the answer comes as `event::answered`.
    confirm: func(question: string) -> result<request-id, string>;
    /// Show work in progress in the tab bar; the user can cancel it from
    /// the palette (`event::task-cancelled`).
    task-start: func(title: string) -> result<task-id, string>;
    /// Progress from 0 to 1 (none: unknown) and a short message.
    task-update: func(id: task-id, progress: option<f32>, message: string);
    task-end: func(id: task-id);

    // --- storage ----------------------------------------------------------------
    /// A small key-value store of the plugin (kept across restarts and
    /// updates; 1 MiB in all). Files go in `/data`.
    storage-get: func(key: string) -> option<string>;
    storage-set: func(key: string, value: string) -> result<_, string>;
    storage-delete: func(key: string);
    storage-keys: func() -> list<string>;

    // --- processes (permission `run-command`) -----------------------------------
    /// Run a program to its end (at most `timeout-ms`, 0: 30 s) and
    /// collect its output (8 MiB each); stdin gets `input`.
    run: func(cmd: command, input: list<u8>, timeout-ms: u32) -> result<output, string>;
    /// Start a program; its output comes as `event::process-output`.
    spawn-process: func(cmd: command) -> result<process-id, string>;
    process-write: func(id: process-id, data: list<u8>) -> result<_, string>;
    process-close-stdin: func(id: process-id);
    process-kill: func(id: process-id);

    // --- network (permission `network`) -----------------------------------------
    /// The whole response (bodies up to 64 MiB).
    http: func(request: http-request) -> result<http-response, string>;
    /// Stream the response (for server-sent events): `event::http-response`,
    /// `http-body`, then `http-done`.
    http-stream: func(request: http-request) -> result<request-id, string>;
    http-cancel: func(id: request-id);

    // --- secrets (permission `secrets`) -----------------------------------------
    /// The plugin's own entries in the desktop keyring (Secret Service).
    secret-get: func(key: string) -> result<option<string>, string>;
    secret-set: func(key: string, value: string) -> result<_, string>;
    secret-delete: func(key: string) -> result<_, string>;

    // --- clipboard (permissions `clipboard-read`, `clipboard-write`) ------------
    clipboard-read: func() -> result<string, string>;
    clipboard-write: func(text: string) -> result<_, string>;

    // --- files (beyond WASI; paths must be inside an `fs` grant) ----------------
    /// Watch a directory (not its subdirectories): `event::fs-changed`.
    watch: func(path: string) -> result<watch-id, string>;
    unwatch: func(id: watch-id);
    /// Move to the desktop trash (needs `rw`).
    trash: func(path: string) -> result<_, string>;
    /// Open with the desktop's default application: a path, or an
    /// `http(s)` / `mailto` URL.
    open: func(path-or-url: string) -> result<_, string>;
    /// `inode/directory`, `text/x-rust`, `image/png`, ... from the name
    /// and the first bytes.
    mime-type: func(path: string) -> result<string, string>;
    /// The entries of a directory with their metadata, in one call (much
    /// faster than WASI for big directories). At most 200,000 entries.
    list-dir: func(path: string) -> result<list<dir-entry>, string>;

    // --- time -----------------------------------------------------------------
    /// `event::timer(id)` after `ms` milliseconds (every `ms` with `repeat`).
    set-timer: func(ms: u32, repeat: bool) -> timer-id;
    cancel-timer: func(id: timer-id);
}

world plugin {
    use types.{event, ui-event, surface-id};
    import host;

    /// Called once after loading. An error unloads the plugin.
    export init: func() -> result<_, string>;
    export on-event: func(event: event);
    export on-ui: func(surface: surface-id, event: ui-event);
}
